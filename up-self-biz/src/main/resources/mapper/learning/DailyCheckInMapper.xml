<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.upself.biz.learning.mapper.DailyCheckInMapper">
<select id="dates" resultType="java.time.LocalDate">SELECT check_date FROM student_daily_check_in WHERE student_id=#{user} ORDER BY check_date DESC</select>
<insert id="insert">INSERT INTO student_daily_check_in(student_id,check_date) VALUES(#{user},#{date})</insert>
</mapper>
