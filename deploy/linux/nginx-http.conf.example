# IP/DNS smoke-test stage only; no real student data over HTTP.
# Replace example.org. Include in the distribution's existing http{} context.
server {
    listen 80;
    server_name example.org www.example.org;

    root /opt/up-self/current/web;
    index index.html;
    client_max_body_size 105m;
    # Do not record media tickets in query/path logs or cache authenticated API data.
    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_intercept_errors off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        access_log off;
    }
    # Uploaded media/assignments are NOT mapped as static directories.
    location / { try_files $uri $uri/ /index.html; }
    location = /index.html { add_header Cache-Control "no-store" always; }
    location ~ /\. { deny all; }
}
