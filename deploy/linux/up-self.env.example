# Future root-only /etc/up-self/up-self.env; systemd EnvironmentFile syntax.
# Replace EVERY REPLACE_ value. Do not source untrusted files or commit real values.
UPSELF_JAVA_HOME=/opt/java/jdk1.8.0_231
UPSELF_CONFIG_DIR=/etc/up-self
UPSELF_DB_URL='jdbc:mysql://127.0.0.1:3306/up_self_prod?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia%2FKuala_Lumpur&useSSL=false'
UPSELF_DB_USER=upself_app
UPSELF_DB_PASSWORD=REPLACE_APP_PASSWORD
UPSELF_MIGRATION_USER=upself_migration
UPSELF_MIGRATION_PASSWORD=REPLACE_MIGRATION_PASSWORD
UPSELF_REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
UPSELF_ADMIN_TOKEN_SECRET=REPLACE_WITH_RANDOM_HEX_AT_LEAST_64_CHARACTERS
UPSELF_STUDENT_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX_AT_LEAST_64_CHARACTERS
# Keep no until Linux JDK license/OS dependencies and Redis port compatibility pass.
UPSELF_LINUX_RUNTIME_REVIEWED=no

# Only for a reviewed empty database's first start. Leave false for restores/updates.
UPSELF_BOOTSTRAP_ENABLED=false
UPSELF_INITIAL_MAINTENANCE_PASSWORD=''
UPSELF_INITIAL_STUDENT_PASSWORD=''
UPSELF_INITIAL_MENTOR_PASSWORD=''
UPSELF_INITIAL_ADMIN_PASSWORD=''
