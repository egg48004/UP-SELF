# Template only. No systemd commands have been executed in this task.
[Unit]
Description=UP-SELF Java backend
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=upself
Group=upself
WorkingDirectory=/opt/up-self/current
EnvironmentFile=/etc/up-self/up-self.env
ExecStart=/bin/bash /opt/up-self/current/linux/run.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
