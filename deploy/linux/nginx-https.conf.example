# Enable only after DNS and certificates are ready; replace every example.org.
server {
    listen 80;
    server_name example.org www.example.org;
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://example.org$request_uri; }
}
server {
    listen 443 ssl;
    server_name www.example.org;
    ssl_certificate /etc/letsencrypt/live/example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name example.org;
    ssl_certificate /etc/letsencrypt/live/example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /opt/up-self/current/web;
    index index.html;
    client_max_body_size 105m;
    # Do not record media tickets in query/path logs or cache authenticated API data.
    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_intercept_errors off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        access_log off;
    }
    # Uploaded media/assignments are NOT mapped as static directories.
    location / { try_files $uri $uri/ /index.html; }
    location = /index.html { add_header Cache-Control "no-store" always; }
    location ~ /\. { deny all; }
}
