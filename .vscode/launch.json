{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "UP-SELF · 本地登录权限服务",
      "request": "launch",
      "mainClass": "com.upself.web.UpSelfApplication",
      "projectName": "up-self-admin",
      "cwd": "${workspaceFolder}",
      "args": "--spring.config.additional-location=file:./config/",
      "console": "internalConsole",
      "vmArgs": "-Dfile.encoding=UTF-8"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "UP-SELF · Frontend",
      "runtimeExecutable": "C:\\Users\\eggma\\Documents\\Codex\\local-env\\nodejs\\node-v24.22.1-win-x64\\node.exe",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "5173",
        "--strictPort",
        "--configLoader",
        "native"
      ],
      "cwd": "${workspaceFolder}/frontend",
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "UP-SELF · Backend + Frontend",
      "configurations": [
        "UP-SELF · 本地登录权限服务",
        "UP-SELF · Frontend"
      ],
      "stopAll": true
    }
  ]
}
