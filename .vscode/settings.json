{
  "maven.terminal.useJavaHome": true,
  "java.configuration.updateBuildConfiguration": "automatic",
  "files.encoding": "utf8",
  "debug.saveBeforeStart": "none",
  "files.exclude": {
    "**/target": true,
    ".local": true,
    "**/node_modules": true
  },
  "search.exclude": {
    ".local": true,
    "**/target": true,
    "**/node_modules": true
  },
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.local/**",
    "**/.git/**",
    "**/frontend/**"
  ],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.local/**": true
  }
}
