{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UP-SELF: 启动数据库与Redis",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/services.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "UP-SELF: 构建",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$javac"
      ]
    },
    {
      "label": "UP-SELF: Frontend dev",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/frontend.ps1",
        "dev"
      ],
      "problemMatcher": []
    },
    {
      "label": "UP-SELF: Frontend build",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/frontend.ps1",
        "build"
      ],
      "problemMatcher": []
    },
    {
      "label": "UP-SELF: Frontend typecheck",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/frontend.ps1",
        "typecheck"
      ],
      "problemMatcher": []
    },
    {
      "label": "UP-SELF: Frontend test",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/frontend.ps1",
        "test"
      ],
      "problemMatcher": []
    }
  ]
}
