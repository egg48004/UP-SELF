{
  "folders": [
    {
      "path": ".",
      "name": "UP-SELF"
    }
  ],
  "settings": {
    "maven.terminal.useJavaHome": true,
    "java.configuration.updateBuildConfiguration": "automatic",
    "files.encoding": "utf8",
    "files.exclude": {
      "**/target": true,
      ".local": true,
      "**/node_modules": true
    },
    "search.exclude": {
      ".local": true,
      "**/target": true,
      "**/node_modules": true
    },
    "java.compile.nullAnalysis.mode": "disabled",
    "debug.saveBeforeStart": "none",
    "java.import.exclusions": [
      "**/node_modules/**",
      "**/.local/**",
      "**/.git/**",
      "**/frontend/**"
    ],
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.local/**": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "UP-SELF · 本地登录权限服务",
        "request": "launch",
        "mainClass": "com.upself.web.UpSelfApplication",
        "projectName": "up-self-admin",
        "cwd": "${workspaceFolder:UP-SELF}",
        "args": "--spring.config.additional-location=file:./config/",
        "console": "internalConsole",
        "vmArgs": "-Dfile.encoding=UTF-8"
      },
      {
        "type": "node",
        "request": "launch",
        "name": "UP-SELF · Frontend",
        "runtimeExecutable": "node",
        "program": "${workspaceFolder:UP-SELF}/frontend/node_modules/vite/bin/vite.js",
        "args": [
          "--host",
          "127.0.0.1",
          "--port",
          "5173",
          "--strictPort",
          "--configLoader",
          "native"
        ],
        "cwd": "${workspaceFolder:UP-SELF}/frontend",
        "console": "internalConsole",
        "skipFiles": [
          "<node_internals>/**"
        ]
      }
    ],
    "compounds": [
      {
        "name": "UP-SELF · Backend + Frontend",
        "configurations": [
          "UP-SELF · 本地登录权限服务",
          "UP-SELF · Frontend"
        ],
        "stopAll": true
      }
    ]
  }
}
